#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 0.001
    metersPerUnit = 0.01
    timeCodesPerSecond = 60
    upAxis = "Y"
)

def Xform "World" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding:physics = </World/Material>

    def PhysicsScene "Physics"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 981
    }

    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.6
        float physics:restitution = 0
        float physics:staticFriction = 0.6
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3 xformOp:scale = (500, 10, 500)
        double3 xformOp:translate = (0, -10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Referenced" (
        prepend references = @physics_units_asset.usda@</Asset>
    )
    {
    }
}

